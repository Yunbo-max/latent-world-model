{
  "model_type": "llama",
  "architectures": [
    "LlamaForCausalLM"
  ],
  "vocab_size": 49152,
  "hidden_size": 384,
  "intermediate_size": 1024,
  "num_hidden_layers": 8,
  "num_attention_heads": 6,
  "num_key_value_heads": 2,
  "max_position_embeddings": 2048,
  "hidden_act": "silu",
  "rms_norm_eps": 0.00001,
  "rope_theta": 100000,
  "tie_word_embeddings": true,
  "attention_bias": false,
  "attention_dropout": 0,
  "bos_token_id": 0,
  "eos_token_id": 0,
  "pad_token_id": 0,
  "initializer_range": 0.02,
  "use_cache": false
}


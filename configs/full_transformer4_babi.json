{
  "stage": "sft_babi",
  "arm": "full_transformer4",
  "model": {
    "vocab_size": 50257,
    "d_model": 256,
    "n_heads": 4,
    "ffn_mult": 4,
    "block_size": 256,
    "memory_slots": 16,
    "prelude_layers": 2,
    "core_layers": 2,
    "coda_layers": 1,
    "loop_steps": 4,
    "dropout": 0.0,
    "checkpoint_layers": true,
    "memory_enabled": true,
    "episodic_enabled": true,
    "episodic_capacity_tokens": 4096,
    "episodic_read_tokens": 512,
    "episodic_top_k": 2,
    "episodic_query_tokens": 32,
    "episodic_policy": "lexical",
    "episodic_include_generated": false,
    "semantic_dim": 128,
    "dynamics": "transformer",
    "contraction_bound": 0.9,
    "predictive_head": true
  },
  "training": {
    "token_budget": 1000000,
    "unroll_segments": 4,
    "accumulate_targets": 8192,
    "learning_rate": 0.0001,
    "min_lr_ratio": 0.1,
    "warmup_tokens": 20000,
    "weight_decay": 0.1,
    "clip_grad_norm": 1.0,
    "seed": 17,
    "precision": "float16",
    "repeat": true,
    "shuffle": true,
    "max_run_seconds": 86400,
    "max_skipped_updates": 5,
    "checkpoint_every_updates": 100,
    "validation_every_updates": 500,
    "validation_targets": 1000000,
    "state_prediction_weight": 0.1
  }
}

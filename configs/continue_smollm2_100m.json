{
  "name": "smollm2-135m-cpt-100m-s17",
  "mechanism": "baseline",
  "model": {
    "initialization": "pretrained"
  },
  "data_manifest": "data/fineweb-100m/manifest.json",
  "total_tokens": 100000000,
  "sequence_length": 512,
  "micro_batch_size": 1,
  "gradient_accumulation_steps": 32,
  "seed": 17,
  "precision": "fp16",
  "learning_rate": 0.00005,
  "weight_decay": 0.1,
  "warmup_fraction": 0.02,
  "min_lr_ratio": 0.1,
  "grad_clip": 1,
  "gradient_checkpointing": true,
  "checkpoint_every_updates": 250,
  "dev_every_updates": 1000,
  "max_consecutive_overflows": 8,
  "max_wall_seconds": 82800
}

